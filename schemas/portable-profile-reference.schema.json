{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlight.local/schemas/portable-profile-reference.schema.json",
  "title": "Portable Starlight Profile Reference",
  "description": "A public registry binding for a canonical Starlight v2 profile. This is not a copy of the canonical repo or team profile schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_id",
    "profile_id",
    "projection",
    "interfaces"
  ],
  "properties": {
    "contract_id": {
      "enum": [
        "starlight.repo_profile.v2",
        "starlight.team_profile.v2"
      ]
    },
    "schema_id": {
      "enum": [
        "https://starlight.local/schemas/starlight-repo-profile.v2.schema.json",
        "https://starlight.local/schemas/starlight-team-profile.v2.schema.json"
      ]
    },
    "profile_id": {
      "type": "string",
      "pattern": "^(repo|team)\\.[a-z0-9][a-z0-9._-]*$"
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_ref",
        "owner_ref",
        "lifecycle",
        "version",
        "last_reviewed"
      ],
      "properties": {
        "kind": {
          "enum": [
            "sanitized_projection",
            "runtime_projection",
            "generated_projection"
          ]
        },
        "source_ref": {
          "type": "string",
          "pattern": "^(https://|repo:)[^\\s]+$"
        },
        "content_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "enum": ["active", "watch", "experimental", "deprecated", "retired"]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "last_reviewed": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_scope_refs",
        "gate_refs",
        "verifier_ref",
        "independent_verifier",
        "routing_refs"
      ],
      "properties": {
        "role_scope_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^agent\\." }
        },
        "gate_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^gate\\." }
        },
        "verifier_ref": {
          "type": "string",
          "pattern": "^agent\\."
        },
        "independent_verifier": {
          "const": true
        },
        "routing_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(routing|workflow)\\." }
        },
        "team_profile_ref": {
          "type": "string",
          "pattern": "^team\\."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "contract_id": { "const": "starlight.repo_profile.v2" } },
        "required": ["contract_id"]
      },
      "then": {
        "properties": {
          "schema_id": { "const": "https://starlight.local/schemas/starlight-repo-profile.v2.schema.json" },
          "profile_id": { "pattern": "^repo\\." },
          "interfaces": { "required": ["team_profile_ref"] }
        }
      }
    },
    {
      "if": {
        "properties": { "contract_id": { "const": "starlight.team_profile.v2" } },
        "required": ["contract_id"]
      },
      "then": {
        "properties": {
          "schema_id": { "const": "https://starlight.local/schemas/starlight-team-profile.v2.schema.json" },
          "profile_id": { "pattern": "^team\\." }
        }
      }
    }
  ]
}
