{
  "schema": "ai-architect-providers/v1",
  "criteria": [
    {
      "id": "performance",
      "title": "Performance",
      "question": "Does the default path meet the latency and quality budget for this workload?"
    },
    {
      "id": "time_to_value",
      "title": "Time to value",
      "question": "How quickly does a team reach a first accepted result with managed parts?"
    },
    {
      "id": "speed_to_execution",
      "title": "Speed to execution",
      "question": "How much undifferentiated wiring stands between the design and a running slice?"
    },
    {
      "id": "cost_efficiency",
      "title": "Cost per accepted result",
      "question": "How predictable and low is the all-attempt cost at the stated volume?"
    },
    {
      "id": "portability",
      "title": "Exit cost",
      "question": "How cheaply can the workload move models, data or runtime later?"
    },
    {
      "id": "governance",
      "title": "Governance fit",
      "question": "Do identity, residency, audit and policy controls exist without custom building?"
    }
  ],
  "scoring_note": "Scores are architect judgement on a 1-5 scale for the pattern as specified, recorded with a rationale. They are not benchmarks. A provider's consumption opportunity never changes a customer score.",
  "providers": [
